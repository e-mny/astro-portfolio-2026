---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import site from "@/config/site";
import { Icon } from "astro-icon/components";
import { getProjects } from "@/utils/post";
import tagsList from "@/content/miscs/tags.json";
import Links from "@/components/blocks/Links.astro";

const projects = await getProjects();
---

<Layout
  title={site.labels.projectsTitle}
  description={`${site.labels.projectsDescription} — ${projects.length} projects.`}
>
  <div
    class="animate-in fade-in slide-in-from-bottom-4 mx-auto max-w-2xl p-8 duration-700 md:p-16"
  >
    <header class="mb-16">
      <h2 class="mb-4 text-3xl font-bold tracking-tight">
        {site.labels.projectsTitle}
      </h2>
      <p class="text-sm font-light text-muted-foreground italic">
        {site.labels.projectsDescription} n = {projects.length}
      </p>
    </header>

    <div class="grid grid-cols-1 items-stretch gap-4 md:grid-cols-2">
      {
        projects.length === 0 ? (
          <div class="col-span-full py-12 text-center">
            <p class="text-sm text-muted-foreground">No projects yet.</p>
          </div>
        ) : (
          projects.map((project) => (
            <div class="group flex h-full flex-col rounded-2xl border border-border/50 bg-muted/20 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:bg-muted/40 hover:shadow-lg">
              <div class="mb-4 flex items-start justify-between">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary/15 text-primary transition-all duration-300 group-hover:bg-primary/25">
                  {project.data.image ? (
                    <Image
                      src={project.data.image}
                      width={50}
                      height={50}
                      alt={`${project.data.title}'s logo'`}
                      loading={"lazy"}
                    />
                  ) : (
                    <span class="text-sm">✦</span>
                  )}
                </div>
                <span
                  class={`rounded-full px-2 py-0.5 text-[9px] font-bold tracking-widest uppercase ${site.statusStyles[project.data.status]}`}
                >
                  {project.data.status}
                </span>
              </div>
              <a
                href={`/projects/${project.id}`}
                class="mb-2 line-clamp-2 min-h-12"
              >
                <h3 class="text-base font-bold">{project.data.title}</h3>
              </a>
              <div class="flex flex-1 flex-col">
                <p class="pb-4 text-xs leading-relaxed text-muted-foreground">
                  {project.data.description}
                </p>
              </div>
              <div class="mb-3 flex flex-wrap gap-2">
                {[
                  ...new Set([
                    ...project.data.tags.map((t) => t.id),
                    ...project.data.tech,
                  ]),
                ].map((id) => {
                  const tag = tagsList.find(
                    (tag) => tag.name.toLowerCase() === id.toLowerCase(),
                  );
                  if (!tag) return null;

                  return (
                    <a href={`/tags/${tag?.slug}`}>
                      <span class="font-mono text-[10px] text-primary/50">
                        #{tag?.name}
                      </span>
                    </a>
                  );
                })}
              </div>
              <Links project={project} class="mt-auto" />
            </div>
          ))
        )
      }
    </div>
  </div>
</Layout>
