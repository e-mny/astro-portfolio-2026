---
import site from "@/config/site";
import Card from "./Card.astro";
import DynamicCard from "./DynamicCard";

const staticCards = site.hero.cards;
---

<section class="mb-8">
  <h2 class="mb-6 text-3xl font-bold tracking-tight">{site.hero.greeting}</h2>
  <p
    class="text-lg leading-relaxed font-light text-muted-foreground"
    set:html={site.hero.description}
  />
</section>

{
  staticCards.length ? (
    <div class="mb-8 grid grid-cols-1 gap-4 md:grid-cols-2">
      {staticCards.map((card, i) => (
        <Card card={card} index={i} />
      ))}
      <DynamicCard client:load />
    </div>
  ) : null
}
