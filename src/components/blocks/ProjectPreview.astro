---
import { formatDate } from "@/utils/date";
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import site from "@/config/site";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

// Auto-detect if project is new based on creation date
const isNew =
  site.features.newPostDays > 0 &&
  (Date.now() - new Date(project.data.createdAt).getTime()) /
    (1000 * 60 * 60 * 24) <=
    site.features.newPostDays;
---

<article
  class="group flex cursor-pointer items-center justify-between border-b border-border/40 py-6 last:border-0"
>
  <div>
    <a
      href={`/projects/${project.id}`}
      class="inline-flex items-center gap-2 text-lg font-semibold text-foreground/80 transition-colors duration-300 group-hover:text-primary"
    >
      <span>{project.data.title}</span>
      {
        isNew && (
          <span class="rounded bg-primary/10 px-1.5 py-0.5 text-[10px] font-bold tracking-wider text-primary uppercase">
            New
          </span>
        )
      }
    </a>
    <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
      {project.data.description}
    </p>
    <p
      class="mt-2 font-mono text-[11px] text-muted-foreground italic opacity-60"
    >
      {formatDate(project.data.createdAt)} —
      {
        project.data.tech && project.data.tech.length > 0 ? (
          <span>{project.data.tech.join(", ")}</span>
        ) : (
          <span>No tech stack specified</span>
        )
      }
    </p>
  </div>
  <span
    class="text-border transition-all duration-300 group-hover:translate-x-1 group-hover:text-primary"
  >
    <Icon name="mdi:arrow-right" />
  </span>
</article>
