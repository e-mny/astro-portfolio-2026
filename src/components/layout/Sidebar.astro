---
import site from "@/config/site";
import Nav from "./Nav.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { Icon } from "astro-icon/components";
import Brand from "./Brand.astro";
import SearchModal from "../blocks/SearchModal.astro";
import SearchBox from "./SearchBox.astro";
---

<aside
  class="custom-scrollbar flex h-full w-full flex-col overflow-y-auto border-b border-border bg-muted/20 px-6 py-3 md:w-[35%] md:border-r md:border-b-0 md:px-12 md:py-6"
  data-pagefind-ignore="all"
>
  <Brand />

  <div class="flex items-center justify-between">
    <div class="flex gap-4 text-muted-foreground/60">
      {
        site.social.map((item) => (
          <a
            href={item.href}
            class="cursor-pointer transition-colors hover:text-primary"
            aria-label={item.name}
          >
            <Icon name={item.icon} size={24} />
          </a>
        ))
      }
    </div>

    <ThemeToggle />
  </div>

  <SearchBox />

  <Nav />

  <SearchModal />
</aside>
