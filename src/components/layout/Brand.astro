---
import site from "@/config/site";
import { Image } from "astro:assets";
---

<div
  class="my-4 flex items-center justify-between md:my-6 md:flex-col md:items-start md:justify-start md:gap-0"
>
  <a href="/" class="flex items-center gap-4">
    <div
      class="flex h-10 w-10 items-center justify-center rounded-xl bg-muted text-lg font-bold text-primary-foreground md:h-11 md:w-11"
    >
      <Image
        loading={"eager"}
        src={site.meta.logo}
        alt={"Site logo"}
        width={50}
        height={50}
      />
    </div>
    <h1
      data-pagefind-ignore
      class="text-lg font-bold tracking-tight text-foreground md:text-xl"
    >
      {site.meta.title}
    </h1>
  </a>
  <p class="text-xs text-muted-foreground/70 md:mt-2">
    {site.meta.description}
  </p>
</div>
