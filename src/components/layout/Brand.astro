---
import site from "@/config/site";
import Avatar from "../blocks/Avatar.astro";
---

<div
  class="my-4 flex items-center justify-between md:my-6 md:flex-col md:items-start md:justify-start md:gap-0"
>
  <a href="/" class="flex items-center gap-7 md:pb-2">
    <div
      class="flex h-10 w-10 items-center justify-center rounded-xl bg-muted text-lg font-bold text-primary-foreground md:h-11 md:w-11"
    >
      <div class="relative">
        <Avatar src="/photos/hero_img.jpg" />
        <span
          id="status-dot"
          class="absolute right-0 bottom-0 h-3 w-3 animate-pulse rounded-full bg-yellow-400"
        ></span>
      </div>
    </div>
    <h1
      data-pagefind-ignore
      class="text-lg font-bold tracking-tight text-foreground md:text-xl"
    >
      {site.meta.title}
    </h1>
  </a>
  <p class="text-xs text-muted-foreground/70 md:mt-2">
    {site.meta.description}
  </p>
</div>

<script>
  const dot = document.getElementById("status-dot") as HTMLSpanElement;

  let timeout: ReturnType<typeof setTimeout>;

  function setAway() {
    dot.classList.remove("rainbow");
    dot.classList.remove("bg-green-600");
    dot.classList.add("bg-yellow-400");
  }

  function setActive() {
    dot.classList.remove("bg-yellow-400");
    dot.classList.add("rainbow");

    clearTimeout(timeout);
    timeout = setTimeout(setAway, 3000);
  }

  // Listen for movement
  window.addEventListener("mousemove", setActive);

  // Initial state
  setAway();
</script>
